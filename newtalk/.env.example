# ── Required ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=            # second Groq account; also used automatically if the primary is rejected
DEEPGRAM_API_KEY=          # legacy phone path + server-side STT fallback
REDDIT_USER_AGENT=NewTalk/0.1

# ── Dashboard / multi-user ────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=            # signs login cookies, call tokens and Telegram link tokens
ADMIN_API_KEY=             # X-Admin-Key header for /pipeline/run and /api/admin/invites

# Telegram ring bot (BotFather -> /newbot). Free; no webhook needed (long polling).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Public HTTPS origin of this server (Cloudflare Tunnel / ngrok). Required for the
# Answer button and browser microphone access. See DEPLOY.md.
PUBLIC_BASE_URL=https://

# ── Optional ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DATABASE_URL=sqlite:///newtalk.db
PORT=8000
HOST=0.0.0.0
FRESHNESS_WINDOW_HOURS=24

PIPELINE_HOURS=6,13,19     # local (Asia/Kolkata) hours the shared pipeline runs
HINGLISH_SCRIPT=mixed      # mixed = Hindi in Devanagari + English in Latin | roman
TTS_RATE=+0%               # edge-tts speaking rate, e.g. +10% or -5%
MAX_LIVE_CALLS=5           # concurrent browser calls
MAX_CALL_SECONDS=1200

# Legacy single-user phone calls via Twilio (paid; trial accounts reach verified numbers only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
USER_PHONE_NUMBER=
